# Copy to .env and fill in. .env is git-ignored and docker-ignored - never commit real keys.

# --- required for LLM interpretation ------------------------------------------------------------
OPENAI_API_KEY=

# --- optional ------------------------------------------------------------------------------------
# "auto" = first model from OPENAI_MODEL_PREFERENCE that this key can access (checked at startup).
OPENAI_MODEL=auto
# Explicit fallback model (default: next accessible model in the preference list).
OPENAI_FALLBACK_MODEL=
OPENAI_MODEL_PREFERENCE=gpt-5.4-mini,gpt-4.1,gpt-5.6-luna,gpt-4.1-mini,gpt-5-mini,gpt-4o-mini
# Used only by reasoning models; dropped automatically for models that do not support it.
OPENAI_REASONING_EFFORT=low
# Any OpenAI-compatible endpoint (e.g. a local/backup provider). Leave empty for api.openai.com.
OPENAI_BASE_URL=

LLM_TIMEOUT_SECONDS=9
REQUEST_DEADLINE_SECONDS=24
LLM_MAX_CONCURRENCY=12
INTERPRETATION_CACHE_SIZE=2048
PORT=8080
LOG_LEVEL=INFO
